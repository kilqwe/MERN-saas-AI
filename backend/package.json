    "@langchain/core": "^1.1.42",
    "@langchain/groq": "^0.1.3",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/openai": "^1.4.5",
    "@langchain/qdrant": "^1.0.2",
    "@qdrant/js-client-rest": "^1.17.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^5.1.0",
    "concurrently": "^8.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "framer-motion": "^12.23.12",
    "groq-sdk": "^0.30.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.1",
    "mongodb": "^6.18.0",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.1",
    "uuid": "^14.0.0"
